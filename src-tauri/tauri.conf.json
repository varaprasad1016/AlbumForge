{
 "$schema": "https://schema.tauri.app/config/2",
 "productName": "AlbumForge",
 "version": "0.10.14",
 "identifier": "com.albumforge.app",
 "build": {
  "beforeDevCommand": "npm run dev:renderer",
  "devUrl": "http://localhost:5173",
  "beforeBuildCommand": "npm run build",
  "frontendDist": "../out/renderer"
 },
 "app": {
  "windows": [
   {
    "title": "AlbumForge",
    "width": 1440,
    "height": 920,
    "minWidth": 1024,
    "minHeight": 700
   }
  ],
  "security": {
   "csp": null,
   "assetProtocol": {
    "enable": true,
    "scope": [
     "$APPCACHE/**",
     "$APPDATA/**",
     "$RESOURCE/fonts/**"
    ]
   }
  }
 },
 "bundle": {
  "active": true,
  "createUpdaterArtifacts": true,
  "targets": [
   "nsis",
   "appimage",
   "dmg"
  ],
  "icon": [
   "icons/icon.png",
   "icons/icon.ico"
  ],
  "resources": {
   "../resources/fonts": "fonts"
  }
 },
 "plugins": {
  "updater": {
   "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCQkU1OUUwMTc5QTQ2QzIKUldUQ1Jwb1g0Rm0raS9DNzFaMVd6c2NXNG9RYkRGUDZoZE5CZDd5eXRUWGdwd0IyTVhVNW1Wd3MK",
   "endpoints": [
    "https://github.com/varaprasad1016/AlbumForge/releases/latest/download/tauri-update.json"
   ]
  }
 }
}
