{
  "name": "albumforge",
  "version": "0.10.14",
  "description": "AlbumForge — automatically compose professionally laid-out albums from finished photographs. Local Windows desktop app.",
  "main": "./out/main/index.js",
  "author": "Vara",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "setup:native": "node scripts/setup-native.mjs",
    "check:native": "node scripts/setup-native.mjs --check",
    "postinstall": "electron-builder install-app-deps"
  },
  "overrides": {
    "sharp": "0.33.5"
  },
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "better-sqlite3": "^11.7.0",
    "electron-updater": "^6.3.9",
    "exifr": "^7.1.3",
    "konva": "^9.3.16",
    "leaflet": "^1.9.4",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "react-window": "^1.8.10",
    "sharp": "0.33.5",
    "svgpath": "^2.6.0",
    "svgson": "^5.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "allowScripts": {
    "sharp@0.32.6": true,
    "sharp@0.33.5": true,
    "onnxruntime-node@1.17.3": true
  }
}
